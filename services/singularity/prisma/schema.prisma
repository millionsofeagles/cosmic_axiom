generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum ReportStatus {
  DRAFT
  FINALIZED
  ARCHIVED
}

enum SectionType {
  FINDING
  CONNECTIVITY
  CUSTOM
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Report {
  id           String          @id @default(uuid())
  engagementId String
  title        String
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  sections     Section[]
  findings     ReportFinding[]
  filename     String?

  executiveSummary   String? @db.Text
  methodology        String? @db.Text
  toolsAndTechniques String? @db.Text
  conclusion         String? @db.Text
}

model Section {
  id               String         @id @default(uuid())
  report           Report         @relation(fields: [reportId], references: [id], onDelete: Cascade)
  reportId         String
  type             SectionType
  position         Int
  title            String?
  content          String?        @db.Text

  reportFinding    ReportFinding? @relation(fields: [reportFindingId], references: [id], onDelete: Cascade)
  reportFindingId  String?

  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model ReportFinding {
  id             String         @id @default(uuid())
  report         Report         @relation(fields: [reportId], references: [id], onDelete: Cascade)
  reportId       String
  sections       Section[]
  images         FindingImage[]  // 0 or more images associated with this finding

  title          String
  description    String         @db.Text
  recommendation String         @db.Text
  impact         String         @db.Text
  severity       Severity
  reference      String?
  tags           Json           @default("[]")
  affectedSystems Json          @default("[]")

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model FindingImage {
  id               String         @id @default(uuid())
  reportFinding    ReportFinding  @relation(fields: [reportFindingId], references: [id], onDelete: Cascade)
  reportFindingId  String

  title            String
  caption          String         @db.Text
  imageData        String         @db.LongText  // Base64 encoded image data
  mimeType         String         // e.g., "image/png", "image/jpeg"

  createdAt        DateTime       @default(now())
}

model DefaultReportTemplate {
  id                 String @id @default("singleton") // Force singleton
  executiveSummary   String @db.Text
  methodology        String @db.Text
  toolsAndTechniques String @db.Text
  conclusion         String @db.Text
}

enum RoeStatus {
  DRAFT
  APPROVED
  ACTIVE
  EXPIRED
  ARCHIVED
}

enum RoeSectionType {
  AUTHORIZATION
  SCOPE
  TESTING_WINDOW
  METHODOLOGY
  RESTRICTIONS
  COMMUNICATION
  EMERGENCY
  LEGAL
  CUSTOM
}

model RulesOfEngagement {
  id           String          @id @default(uuid())
  engagementId String
  title        String
  version      String          @default("1.0")
  status       RoeStatus       @default(DRAFT)
  
  // Key dates
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  approvedAt   DateTime?
  expiresAt    DateTime?
  
  // Authorization details
  authorizedBy    String?
  authorizedTitle String?
  authorizedDate  DateTime?
  
  // Document metadata
  classification  String?       @default("CONFIDENTIAL")
  filename        String?
  
  // Sections
  sections        RoeSection[]
  
  // Quick access fields for common content
  testingWindow   Json?         // {start, end, blackoutPeriods: []}
  emergencyContact Json?        // {name, phone, email, availability}
  
  @@index([engagementId])
}

model RoeSection {
  id        String         @id @default(uuid())
  roe       RulesOfEngagement @relation(fields: [roeId], references: [id], onDelete: Cascade)
  roeId     String
  
  type      RoeSectionType
  position  Int
  title     String
  content   String         @db.Text
  
  // For structured data sections
  data      Json?          // Flexible JSON for section-specific data
  
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  
  @@index([roeId, position])
}

model RoeTemplate {
  id          String   @id @default(uuid())
  name        String
  description String?
  isDefault   Boolean  @default(false)
  
  // Template content
  sections    Json     // Array of template sections
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([isDefault])
}

model RoeSectionTemplate {
  id          String         @id @default(uuid())
  sectionType RoeSectionType @unique
  title       String
  content     String         @db.Text
  
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}
